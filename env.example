# Copy to `.env` next to docker-compose.yml and fill in your values.
# DO NOT COMMIT the real `.env` file — only this example.

# --- Required ---
JWT_SECRET=change-me-to-a-64-char-hex-string
ADMIN_PASSWORD=change-me-strong-password

# --- Public URLs ---
# The public URL where the frontend will be reachable (used in email links,
# OG share tags, and the Google-OAuth return path).
FRONTEND_URL=http://localhost:3000

# The public URL where the backend will be reachable, from the *browser*'s
# perspective. CRA bakes this into the JS bundle at build time.
REACT_APP_BACKEND_URL=http://localhost:8001

# --- Optional ---
DB_NAME=crystalmeets
CORS_ORIGINS=*
ADMIN_EMAIL=admin@crystalmeets.ie
SENDER_EMAIL=onboarding@resend.dev
# Leave RESEND_API_KEY empty to queue reminders without sending (useful in dev).
RESEND_API_KEY=
